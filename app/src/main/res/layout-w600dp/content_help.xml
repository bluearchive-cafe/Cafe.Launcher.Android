<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/content_horizontal_padding"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/content_horizontal_padding"
    android:paddingBottom="@dimen/content_bottom_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_18">

        <TextView
            style="@style/TextAppearance.Installer.Headline5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_title" />

        <TextView
            style="@style/TextAppearance.Installer.Body1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:lineSpacingExtra="4sp"
            android:text="@string/help_body" />

        <TextView
            style="@style/TextAppearance.Installer.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/detail_surface"
            android:lineSpacingExtra="4sp"
            android:padding="@dimen/space_16"
            android:text="@string/help_note" />
    </LinearLayout>
</ScrollView>
