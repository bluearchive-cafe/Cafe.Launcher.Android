<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/surface_card"
        android:elevation="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_status_info" />

        <TextView
            android:id="@+id/titleText"
            style="@style/TextAppearance.Installer.Headline5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/messageText"
            style="@style/TextAppearance.Installer.Body1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4sp"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/supportingText"
            style="@style/TextAppearance.Installer.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="start"
            android:lineSpacingExtra="2sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/cd_progress_indeterminate"
            android:indeterminate="false"
            android:indeterminateTint="@color/primary"
            android:max="100"
            android:progressBackgroundTint="@color/progress_track"
            android:progressTint="@color/primary"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/indeterminateBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/cd_progress_indeterminate"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/splitLabel"
            style="@style/TextAppearance.Installer.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/etaLabel"
            style="@style/TextAppearance.Installer.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAlignment="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorDetail"
            style="@style/TextAppearance.Installer.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/detail_surface"
            android:fontFamily="monospace"
            android:maxLines="8"
            android:scrollbars="vertical"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/primaryButton"
            style="@style/Widget.Installer.Button.Contained"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/secondaryButton"
            style="@style/Widget.Installer.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/tertiaryButton"
            style="@style/Widget.Installer.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
