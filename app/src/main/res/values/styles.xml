<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Installer.Headline5" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/on_surface_high</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Installer.Body1" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/on_surface_high</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Installer.Body2" parent="android:style/TextAppearance.Material.Body2">
        <item name="android:textColor">@color/on_surface_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Installer.Caption" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/on_surface_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Installer.Button.Contained" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_contained</item>
        <item name="android:elevation">2dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/btn_text_contained</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Installer.Button.Outlined" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/btn_outlined</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/btn_text_outlined</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Installer.Button.Text" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/btn_text_outlined</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
