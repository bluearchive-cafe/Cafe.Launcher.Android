    <string name="settings_group_install_method">Install method</string>
    <string name="settings_install_mode_label">Install mode</string>
    <string name="settings_install_mode_desc_system">Use the standard Android package installer. Works on all devices but may require granting "Install unknown apps" permission.</string>
    <string name="settings_install_mode_desc_shizuku">Use Shizuku to install with ADB/root identity. Bypasses system permission dialogs.\n\nRequires Shizuku to be installed and running.</string>
    <string name="settings_install_mode_desc_root">Use root (su) to install directly. Bypasses all permission dialogs.\n\nRequires a rooted device with a superuser app.</string>
