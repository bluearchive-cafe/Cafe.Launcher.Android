<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/nav_settings_filled"
        android:state_checked="true"
        android:drawable="@drawable/ic_nav_settings_filled" />
    <item
        android:id="@+id/nav_settings_outline"
        android:drawable="@drawable/ic_nav_settings_outline" />
    <transition
        android:fromId="@id/nav_settings_outline"
        android:toId="@id/nav_settings_filled"
        android:drawable="@drawable/avd_nav_settings_outline_to_filled" />
    <transition
        android:fromId="@id/nav_settings_filled"
        android:toId="@id/nav_settings_outline"
        android:drawable="@drawable/avd_nav_settings_filled_to_outline" />
</animated-selector>
